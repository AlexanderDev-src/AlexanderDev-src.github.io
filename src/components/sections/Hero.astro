---
import { site } from '../../data/site';
---

<section class="container hero" aria-label="Introduction">
	<div class="hero__text">
		<p class="hero__meta" data-depth>
			<span>Junior Developer</span>
			<span class="hero__sep" aria-hidden="true">✦</span>
			<span>{site.focus}</span>
			<span class="hero__sep" aria-hidden="true">✦</span>
			<span>Local time <time id="local-time" data-tz={site.timeZone}>--:--</time></span>
		</p>

		<h1 class="hero__title">
			<span class="hero__line" data-depth>Hi, I'm</span>{' '}
			<span class="hero__line gradient-text" data-depth>{site.name.split(' ')[0]}.</span>
		</h1>

		<p class="hero__intro" data-depth>{site.intro}</p>

		<div class="hero__actions" data-depth>
			<a class="btn btn--primary" href="#work">Explore my work <span class="mono" aria-hidden="true">→</span></a>
			<a class="btn btn--ghost" href={site.resume}>Download résumé</a>
		</div>
	</div>

	<div class="hero__visual" data-depth>
		<canvas id="blackhole" class="hero__hole" data-emerge aria-hidden="true"></canvas>
		<span class="hero__scroll" aria-hidden="true">Scroll to explore ↓</span>
	</div>
</section>

<script>
	const el = document.getElementById('local-time');
	if (el) {
		const format = new Intl.DateTimeFormat('en-GB', {
			hour: '2-digit',
			minute: '2-digit',
			timeZone: el.dataset.tz || undefined,
		});
		const tick = () => {
			el.textContent = format.format(new Date());
		};
		tick();
		setInterval(tick, 30000);
	}

	// Parallax: while the hero scrolls away, each layer lags behind by its own amount (--lag), lower
	// layers more, so they drift apart instead of into each other.
	const hero = document.querySelector<HTMLElement>('.hero');
	const layers = [...(hero?.querySelectorAll<HTMLElement>('[data-depth]') ?? [])].map((el) => ({
		el,
		lag: Number(getComputedStyle(el).getPropertyValue('--lag')) || 0,
	}));

	if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let last = -1;
		let queued = false;
		const update = () => {
			queued = false;
			const y = Math.min(window.scrollY, hero.offsetHeight);
			if (y === last) return;
			last = y;
			for (const { el, lag } of layers) el.style.translate = `0 ${(y * lag).toFixed(1)}px`;
		};
		window.addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);
		update();
	}
</script>

<style>
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
		align-items: center;
		gap: 40px;
		min-height: calc(100vh - var(--header-h));
		padding-top: clamp(72px, 12vh, 140px);
		padding-bottom: clamp(64px, 10vh, 120px);
	}

	.hero__text {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.hero__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 14px;
		font-size: 14px;
		font-weight: 500;
		color: var(--color-muted);
	}

	.hero__meta > span {
		white-space: nowrap;
	}

	.hero__sep {
		color: var(--color-amber);
		opacity: 0.7;
	}

	.hero__meta time {
		font-variant-numeric: tabular-nums;
	}

	.hero__line {
		display: inline-block;
	}

	.hero__title {
		font-family: var(--font-display);
		font-weight: 800;
		/* "Alexander." is about 8.1em wide; the cap keeps it on small screens. */
		font-size: min(clamp(52px, 8.4vw, 128px), (100vw - 2 * var(--gutter)) / 8.4);
		line-height: 0.92;
		letter-spacing: -0.035em;
	}

	.hero__intro {
		max-width: 40ch;
		font-size: clamp(17px, 1.5vw, 20px);
		line-height: 1.65;
		color: var(--color-text-soft);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.btn {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 14px 22px;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		font-size: 15px;
		font-weight: 600;
		transition:
			background-color 0.2s,
			border-color 0.2s,
			color 0.2s;
	}

	.btn--primary {
		background: var(--color-amber-soft);
		color: oklch(0.14 0.03 285);
	}

	.btn--primary:hover {
		background: var(--color-amber);
		color: oklch(0.14 0.03 285);
	}

	.btn--ghost {
		border-color: oklch(1 0 0 / 0.2);
	}

	.btn--ghost:hover {
		border-color: var(--color-amber);
	}

	.hero__visual {
		position: relative;
		z-index: 1;
		justify-self: center;
		width: 100%;
		max-width: 680px;
		aspect-ratio: 1 / 1;
	}

	.hero__hole {
		position: absolute;
		inset: -15%;
		width: 130%;
		max-width: none;
		height: 130%;
		pointer-events: none;
	}

	.hero__scroll {
		position: absolute;
		right: 4%;
		bottom: 6%;
		font-size: 13px;
		font-weight: 500;
		color: var(--color-faint);
	}

	/* Depth of each layer. --depth sets how far it flies in on arrival (nearer flies further),
	   --lag how much it trails when scrolled (see the script). */
	.hero__meta {
		--depth: 0.35;
		--delay: 0.45s;
		--lag: 0;
	}

	.hero__line:first-child {
		--depth: 0.7;
		--delay: 0.55s;
		--lag: 0.04;
	}

	.hero__line:last-child {
		--depth: 1;
		--delay: 0.62s;
		--lag: 0.08;
	}

	.hero__intro {
		--depth: 0.5;
		--delay: 0.75s;
		--lag: 0.14;
	}

	.hero__actions {
		--depth: 0.4;
		--delay: 0.85s;
		--lag: 0.2;
	}

	/* The hole is deepest. No blur and no scale on it: cosmos.ts measures its canvas on load. */
	.hero__visual {
		--depth: 0.12;
		--delay: 0s;
		--blur: 0px;
		--lag: 0.22;
	}

	/* Arrival, just out of the black hole: the layers slide in from its side at once, but each
	   travels a different distance, so the page reads as layers at different depths.
	   The drift on scroll uses `translate`, so it adds to this `transform`. */
	@media (prefers-reduced-motion: no-preference) {
		.hero [data-depth] {
			animation: hero-emerge 1.6s cubic-bezier(0.16, 1, 0.3, 1) var(--delay) backwards;
		}
	}

	@keyframes hero-emerge {
		from {
			opacity: 0;
			filter: blur(var(--blur, 10px));
			transform: translate(calc(var(--depth) * 200px), calc(var(--depth) * 28px));
		}
	}
</style>
