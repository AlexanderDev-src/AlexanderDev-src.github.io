---
import { draftNote, placeholderPhotos, type Project } from '../data/site';

type Props = Project;

const { name, year, kind, description, tags, image, photos, demo, code } = Astro.props;

// Without its own photos or image, a project shows placeholders and the draft note.
const draft = !photos?.length && !image;
const seed = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'project';
const gallery = photos?.length ? photos : image ? [{ src: image, caption: name }] : placeholderPhotos(seed);
const cover = gallery.slice(0, 3);
---

<article class="card">
	<button
		type="button"
		class="card__media"
		data-gallery={JSON.stringify({ name, year, kind, draft, photos: gallery })}
		aria-haspopup="dialog"
		aria-label={`View photos of ${name}`}
	>
		<span class="card__collage" data-count={cover.length}>
			{cover.map((photo) => <img src={photo.src} alt="" loading="lazy" decoding="async" />)}
		</span>
		<span class="card__shade" aria-hidden="true"></span>
		<span class="card__kind">{kind}</span>
		<span class="card__view">
			{gallery.length} {gallery.length === 1 ? 'photo' : 'photos'} · View <span aria-hidden="true">→</span>
		</span>
	</button>

	<div class="card__body">
		<div class="card__head">
			<h3 class="card__title">{name}</h3>
			<span class="card__year">{year}</span>
		</div>
		<p class="card__desc">{description}</p>
		{
			draft && (
				<p class="card__note">
					<span class="card__dot" aria-hidden="true" />
					{draftNote}
				</p>
			)
		}
		<ul role="list" class="card__tags">
			{tags.map((tag) => <li>{tag}</li>)}
		</ul>
		<div class="card__links">
			{demo && <a href={demo}>Live demo <span class="mono" aria-hidden="true">↗</span></a>}
			{code && <a class="card__code" href={code}>Code <span class="mono" aria-hidden="true">↗</span></a>}
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 12px;
		border-radius: 24px;
		background: linear-gradient(
			160deg,
			oklch(0.16 0.03 290 / 0.75),
			oklch(0.11 0.02 280 / 0.75)
		);
		border: 1px solid var(--hairline);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		transition:
			transform 0.6s var(--ease-out),
			border-color 0.6s,
			box-shadow 0.6s;
	}

	.card:hover {
		transform: translateY(-8px);
		border-color: oklch(0.72 0.17 300 / 0.5);
		box-shadow: 0 20px 60px -20px oklch(0.6 0.2 300 / 0.5);
	}

	.card__media {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		padding: 0;
		overflow: hidden;
		border: 0;
		border-radius: 16px;
		background: oklch(0.17 0.03 290);
		color: inherit;
		font-family: var(--font-mono);
		cursor: pointer;
	}

	.card__collage {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: 2fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 6px;
	}

	.card__collage img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card__collage img:first-child,
	.card__collage[data-count='2'] img {
		grid-row: 1 / span 2;
	}

	.card__collage[data-count='1'] {
		grid-template-columns: 1fr;
	}

	.card__collage[data-count='2'] {
		grid-template-columns: 1fr 1fr;
	}

	.card__shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 55%, oklch(0.08 0.015 285 / 0.85));
	}

	.card__shade::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, oklch(0.2 0.08 300 / 0.25), oklch(0.08 0.015 285 / 0.9));
		opacity: 0;
		transition: opacity 0.5s;
	}

	.card__media:hover .card__shade::after,
	.card__media:focus-visible .card__shade::after {
		opacity: 1;
	}

	.card__kind,
	.card__view {
		position: absolute;
		border-radius: 999px;
		white-space: nowrap;
		pointer-events: none;
	}

	.card__kind {
		top: 10px;
		left: 10px;
		padding: 4px 10px;
		background: oklch(0.08 0.015 285 / 0.8);
		color: oklch(0.86 0.1 60);
		font-size: 11px;
	}

	.card__view {
		right: 12px;
		bottom: 12px;
		padding: 7px 14px;
		background: oklch(0.95 0.01 290 / 0.92);
		color: oklch(0.14 0.03 285);
		font-size: 12px;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 4px 10px 10px;
	}

	.card__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}

	.card__title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 26px;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.card__year {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--color-faint);
	}

	.card__desc {
		font-size: 15px;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.card__note {
		display: flex;
		gap: 10px;
		padding: 10px 12px;
		border: 1px dashed oklch(0.82 0.14 60 / 0.35);
		border-radius: 16px;
		background: oklch(0.82 0.14 60 / 0.06);
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.6;
		color: oklch(0.86 0.1 60);
	}

	.card__dot {
		flex-shrink: 0;
		width: 7px;
		height: 7px;
		margin-top: 0.55em;
		border-radius: 50%;
		background: var(--color-amber);
		box-shadow: 0 0 10px var(--color-amber);
	}

	.card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: oklch(0.86 0.08 300);
	}

	.card__tags li {
		padding: 4px 9px;
		border-radius: 6px;
		background: oklch(0.72 0.17 300 / 0.14);
	}

	.card__links {
		display: flex;
		gap: 20px;
		padding-top: 6px;
		font-size: 14px;
	}

	.card__links a {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.card__links .card__code {
		color: oklch(0.8 0.02 290);
	}

	.card__links .card__code:hover {
		color: var(--color-amber);
	}
</style>
