---
import { site, socials } from '../../data/site';
---

<section id="contact" class="container contact">
	<span class="label" data-arrive="label">04 / CONTACT</span>

	<h2 class="contact__title" data-arrive="title">Let's build something <span class="gradient-text">together.</span></h2>

	<p class="contact__text">Have an internship, a project, or just a question? Send me a message.</p>

	{/* Line breaks only after "." or "@", never in the middle of a word. */}
	<a class="contact__email" href={`mailto:${site.email}`}>
		{site.email.split(/(?<=[.@])/).map((part) => <Fragment>{part}<wbr /></Fragment>)}
	</a>

	<ul role="list" class="contact__socials">
		{
			socials.map((social) => (
				<li>
					<a href={social.href} target="_blank" rel="noopener noreferrer">
						{social.label} ↗
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.contact {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 30px;
		padding-block: clamp(80px, 14vh, 160px);
		text-align: center;
	}

	.contact__title {
		max-width: 12ch;
		font-family: var(--font-display);
		font-weight: 800;
		/* "something" is about 8.1em wide; the cap keeps it on small screens.
		   Smaller than the hero title so the page has one loudest line. */
		font-size: min(clamp(44px, 6.4vw, 96px), (100vw - 2 * var(--gutter)) / 8.4);
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	.contact__text {
		max-width: 44ch;
		font-size: 18px;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.contact__email {
		max-width: 100%;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(22px, 3vw, 38px);
		letter-spacing: -0.01em;
		color: var(--color-amber-soft);
		text-decoration: underline;
		text-decoration-color: oklch(0.82 0.14 60 / 0.4);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
		overflow-wrap: anywhere;
		text-wrap: balance;
		transition:
			color 0.2s,
			text-decoration-color 0.2s;
	}

	.contact__email:hover {
		text-decoration-color: currentColor;
	}

	.contact__socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px 28px;
		padding-top: 8px;
		font-size: 15px;
		font-weight: 500;
		color: var(--color-muted);
	}

	.contact__socials a {
		color: inherit;
	}

	.contact__socials a:hover {
		color: var(--color-amber);
	}
</style>
