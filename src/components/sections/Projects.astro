---
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import ProjectGallery from '../ProjectGallery.astro';
import { projects, projectTime } from '../../data/site';

const sorted = [...projects].sort((a, b) => projectTime(b.year) - projectTime(a.year));
---

<section id="work" class="container projects">
	<div class="projects__header">
		<SectionHeading label="01 / PROJECTS" title="Things I've built" />
		<span class="projects__note">Web · Machine Learning · Deep Learning · Data</span>
	</div>

	<div class="projects__grid">
		{sorted.map((project) => <ProjectCard {...project} />)}
	</div>

	<ProjectGallery />
</section>

<style>
	.projects {
		display: flex;
		flex-direction: column;
		gap: 44px;
		padding-block: clamp(48px, 8vh, 96px);
	}

	.projects__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
	}

	.projects__note {
		max-width: 100%;
		font-size: 14px;
		font-weight: 500;
		color: var(--color-faint);
		text-wrap: balance;
	}

	.projects__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
		gap: clamp(40px, 4vw, 56px) clamp(24px, 3vw, 40px);
	}
</style>
