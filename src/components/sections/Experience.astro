---
import SectionHeading from '../SectionHeading.astro';
import { experience } from '../../data/site';
---

<section id="experience" class="section">
	<div class="container split">
		<div class="split__aside">
			<SectionHeading index="03" title="Experience">
				<p>Where I've worked and what I did there.</p>
			</SectionHeading>
		</div>

		<ol role="list" class="timeline">
			{
				experience.map((item) => (
					<li class="timeline__item">
						<p class="eyebrow timeline__period">{item.period}</p>
						<div>
							<h3 class="timeline__role">{item.role}</h3>
							<p class="timeline__company">{item.company}</p>
						</div>
						<p class="timeline__summary">{item.summary}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.timeline {
		border-bottom: 1px solid var(--color-border);
	}

	.timeline__item {
		display: grid;
		gap: 0.75rem;
		padding-block: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.timeline__period {
		padding-top: 0.3rem;
	}

	.timeline__role {
		font-size: var(--text-lg);
	}

	.timeline__company,
	.timeline__summary {
		color: var(--color-muted);
	}

	@media (min-width: 768px) {
		.timeline__item {
			grid-template-columns: 10rem minmax(0, 1fr) minmax(0, 1.4fr);
			gap: 2rem;
		}
	}
</style>
