---
// Stand-in for images and media. Replace with <Image /> from 'astro:assets' when you have real assets.
interface Props {
	label?: string;
	ratio?: string;
}

const { label = 'Image', ratio } = Astro.props;
---

<div class="placeholder" style={ratio ? `aspect-ratio: ${ratio}` : undefined}>
	<span>{label}</span>
</div>

<style>
	.placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		min-height: 100%;
		background:
			repeating-linear-gradient(
				45deg,
				var(--color-surface-2) 0 10px,
				transparent 10px 20px
			),
			var(--color-surface);
		border: 1px dashed var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>
