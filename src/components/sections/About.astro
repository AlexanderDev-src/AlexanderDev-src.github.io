---
import { site, about, timeline } from '../../data/site';
---

<section id="about" class="container about">
	<div class="about__main">
		<span class="label" data-arrive="label">03 / ABOUT ME</span>

		<div class="about__intro">
			<div class="about__portrait">
				<span class="about__ring about__ring--inner" aria-hidden="true"></span>
				<span class="about__ring about__ring--outer" aria-hidden="true"></span>
				<span class="about__satellite" aria-hidden="true"></span>
				<div class="about__photo">
					{about.portrait ? <img src={about.portrait} alt={`Portrait of ${site.name}`} width="220" height="220" /> : <span>Your photo</span>}
				</div>
			</div>
			<div class="about__who">
				<span class="about__name">{site.name}</span>
				<span class="about__role">{site.role}</span>
			</div>
		</div>

		<p class="about__quote" data-arrive="title">
			{about.quote.before}<span class="about__highlight">{about.quote.highlight}</span>{about.quote.after}
		</p>
		<p class="about__bio">{about.bio}</p>
	</div>

	<div class="about__timeline">
		<h3 class="about__timeline-title">EDUCATION &amp; EXPERIENCE</h3>
		<ol role="list">
			{
				timeline.map((entry) => (
					<li class="timeline__row">
						<span class="timeline__dot" aria-hidden="true" />
						<span class="timeline__when">{entry.when}</span>
						<div class="timeline__what">
							<span class="timeline__title">{entry.title}</span>
							<span class="timeline__place">{entry.place}</span>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.about {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
		gap: clamp(40px, 6vw, 96px);
		padding-block: clamp(80px, 14vh, 160px);
	}

	.about__main {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.about__intro {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 28px;
	}

	/* The outer ring sits 30px outside; the margin keeps it on screen when the gutter is smaller. */
	.about__portrait {
		position: relative;
		flex-shrink: 0;
		width: 220px;
		height: 220px;
		margin-left: max(0px, 30px - var(--gutter));
	}

	.about__ring {
		position: absolute;
		border-radius: 50%;
	}

	.about__ring--inner {
		inset: -14px;
		border: 1px solid oklch(0.72 0.17 300 / 0.45);
	}

	.about__ring--outer {
		inset: -30px;
		border: 1px dashed oklch(0.82 0.14 60 / 0.25);
	}

	.about__satellite {
		position: absolute;
		top: -17px;
		left: 50%;
		width: 7px;
		height: 7px;
		margin-left: -3px;
		border-radius: 50%;
		background: var(--color-amber);
	}

	.about__photo {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-radius: 50%;
		background: repeating-linear-gradient(
			135deg,
			oklch(0.19 0.03 290) 0 10px,
			oklch(0.165 0.03 290) 10px 20px
		);
		box-shadow: 0 0 40px oklch(0.6 0.2 300 / 0.25);
		font-size: 14px;
		font-weight: 500;
		color: var(--color-faint);
	}

	.about__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about__who {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.about__name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 22px;
	}

	.about__role {
		font-size: 15px;
		color: var(--color-muted);
	}

	.about__quote {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(28px, 3.2vw, 42px);
		line-height: 1.15;
		letter-spacing: -0.025em;
	}

	.about__highlight {
		color: var(--color-magenta);
	}

	.about__bio {
		max-width: 48ch;
		font-size: 17px;
		line-height: 1.8;
		color: var(--color-muted);
	}

	.about__timeline {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.about__timeline-title {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--color-muted);
	}

	.timeline__row {
		display: grid;
		grid-template-columns: 24px 110px minmax(0, 1fr);
		align-items: baseline;
		gap: 16px;
		padding-block: 22px;
		border-top: 1px solid var(--hairline);
	}

	.timeline__dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-magenta);
	}

	.timeline__when {
		font-size: 14px;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		color: var(--color-muted-2);
	}

	.timeline__what {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.timeline__title {
		font-size: 17px;
		font-weight: 500;
	}

	.timeline__place {
		font-size: 15px;
		color: var(--color-muted);
	}
</style>
