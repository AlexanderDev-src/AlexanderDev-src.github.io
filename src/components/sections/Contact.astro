---
import { site, socials } from '../../data/site';
---

<section id="contact" class="container contact">
	<span class="label">04 / CONTACT</span>

	<h2 class="contact__title">Let's build something <span class="gradient-text">together.</span></h2>

	<p class="contact__text">Have an internship, a project, or just a question? Send me a message.</p>

	{/* Line breaks only after "." or "@", never in the middle of a word. */}
	<a class="contact__email" href={`mailto:${site.email}`}>
		{site.email.split(/(?<=[.@])/).map((part) => <Fragment>{part}<wbr /></Fragment>)}
	</a>

	<ul role="list" class="contact__socials">
		{
			socials.map((social) => (
				<li>
					<a href={social.href} target="_blank" rel="noopener noreferrer">
						{social.label} ↗
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.contact {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 30px;
		padding-block: clamp(80px, 14vh, 160px);
		text-align: center;
	}

	.contact__title {
		max-width: 12ch;
		font-family: var(--font-display);
		font-weight: 800;
		/* "something" is about 8.1em wide; the cap keeps it on small screens. */
		font-size: min(clamp(48px, 8vw, 120px), (100vw - 2 * var(--gutter)) / 8.4);
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	.contact__text {
		max-width: 44ch;
		font-size: 18px;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.contact__email {
		max-width: 100%;
		padding: 18px 30px;
		border-radius: 999px;
		border: 1px solid oklch(0.72 0.17 300 / 0.5);
		background: oklch(0.72 0.17 300 / 0.08);
		box-shadow: 0 0 40px oklch(0.6 0.2 300 / 0.25);
		font-family: var(--font-mono);
		font-size: clamp(18px, 2.2vw, 26px);
		overflow-wrap: anywhere;
		text-wrap: balance;
		transition:
			box-shadow 0.4s,
			color 0.2s;
	}

	.contact__email:hover {
		box-shadow: 0 0 70px oklch(0.6 0.2 300 / 0.5);
	}

	.contact__socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 28px;
		padding-top: 8px;
		font-size: 15px;
	}
</style>
