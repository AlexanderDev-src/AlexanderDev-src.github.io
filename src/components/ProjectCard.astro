---
import { draftNote as defaultNote, placeholderPhotos, projectFilterKeys, type Project } from '../data/site';

// hidden: start collapsed behind the "Show more" button.
type Props = Project & { hidden?: boolean };

const { name, year, kind, description, tags, image, photos, demo, code, draftNote, hidden } = Astro.props;

// Without its own photos or image, a project shows placeholders and is a draft unless it says otherwise.
const draft = Astro.props.draft ?? (!photos?.length && !image);
const note = draftNote ?? defaultNote;
const seed = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'project';
const gallery = photos?.length ? photos : image ? [{ src: image, caption: name }] : placeholderPhotos(seed);
const cover = gallery.slice(0, 3);
---

<article class="card" data-filters={projectFilterKeys(Astro.props).join('|')} hidden={hidden}>
	<button
		type="button"
		class="card__media"
		data-gallery={JSON.stringify({ name, year, kind, draft, note, photos: gallery })}
		aria-haspopup="dialog"
		aria-label={`View photos of ${name}`}
	>
		<span class="card__collage" data-count={cover.length}>
			{cover.map((photo) => <img src={photo.src} alt="" loading="lazy" decoding="async" />)}
		</span>
		<span class="card__shade" aria-hidden="true"></span>
		<span class="card__kind">{kind}</span>
		<span class="card__view">
			{gallery.length} {gallery.length === 1 ? 'photo' : 'photos'} · View <span aria-hidden="true">→</span>
		</span>
	</button>

	<div class="card__body">
		<div class="card__head">
			<h3 class="card__title">{name}</h3>
			<span class="card__year">{year}</span>
		</div>
		<p class="card__desc">{description}</p>
		{
			draft && (
				<p class="card__note">
					<span class="card__dot" aria-hidden="true" />
					{note}
				</p>
			)
		}
		<ul role="list" class="card__tags">
			{tags.map((tag) => <li>{tag}</li>)}
		</ul>
		<div class="card__links">
			{demo && <a href={demo}>Live demo <span class="mono" aria-hidden="true">↗</span></a>}
			{code && <a class="card__code" href={code}>Code <span class="mono" aria-hidden="true">↗</span></a>}
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	/* Hidden by the project filters. */
	.card[hidden] {
		display: none;
	}

	.card__media {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		padding: 0;
		overflow: hidden;
		border: 1px solid var(--hairline-strong);
		border-radius: var(--radius-md);
		background: oklch(0.17 0.03 290);
		color: inherit;
		font-weight: 600;
		cursor: pointer;
		transition: border-color 0.3s;
	}

	.card__media:hover {
		border-color: oklch(0.82 0.14 60 / 0.6);
	}

	.card__collage {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: 2fr 1fr;
		grid-template-rows: 1fr 1fr;
		gap: 3px;
	}

	.card__collage img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card__collage img:first-child,
	.card__collage[data-count='2'] img {
		grid-row: 1 / span 2;
	}

	.card__collage[data-count='1'] {
		grid-template-columns: 1fr;
	}

	.card__collage[data-count='2'] {
		grid-template-columns: 1fr 1fr;
	}

	.card__shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 55%, oklch(0.08 0.015 285 / 0.85));
	}

	.card__shade::after {
		content: '';
		position: absolute;
		inset: 0;
		background: oklch(0.08 0.015 285 / 0.45);
		opacity: 0;
		transition: opacity 0.5s;
	}

	.card__media:hover .card__shade::after,
	.card__media:focus-visible .card__shade::after {
		opacity: 1;
	}

	.card__kind,
	.card__view {
		position: absolute;
		border-radius: 999px;
		white-space: nowrap;
		pointer-events: none;
	}

	.card__kind {
		top: 12px;
		left: 12px;
		padding: 4px 10px;
		background: oklch(0.08 0.015 285 / 0.8);
		color: var(--color-amber-soft);
		font-size: 12px;
	}

	.card__view {
		right: 12px;
		bottom: 12px;
		padding: 7px 14px;
		background: oklch(0.95 0.01 290 / 0.92);
		color: oklch(0.14 0.03 285);
		font-size: 13px;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.card__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}

	.card__title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 28px;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.card__year {
		flex-shrink: 0;
		font-size: 14px;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		color: var(--color-faint);
	}

	.card__desc {
		max-width: 60ch;
		font-size: 16px;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.card__note {
		display: flex;
		gap: 10px;
		max-width: 60ch;
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-amber-soft);
	}

	.card__dot {
		flex-shrink: 0;
		width: 7px;
		height: 7px;
		margin-top: 0.55em;
		border-radius: 50%;
		background: var(--color-amber);
	}

	.card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		font-size: 13px;
		font-weight: 500;
		color: var(--color-muted);
	}

	.card__tags li {
		padding: 3px 9px;
		border: 1px solid var(--hairline-strong);
		border-radius: var(--radius-sm);
	}

	.card__tags:empty {
		display: none;
	}

	.card__links {
		display: flex;
		gap: 24px;
		padding-top: 4px;
		font-size: 15px;
		font-weight: 500;
	}

	.card__links a {
		text-decoration: underline;
		text-decoration-color: oklch(1 0 0 / 0.3);
		text-underline-offset: 0.3em;
	}

	.card__links a:hover {
		text-decoration-color: currentColor;
	}

	/* inline-block keeps the underline off the arrow. */
	.card__links .mono {
		display: inline-block;
		margin-left: 4px;
	}

	.card__links .card__code {
		color: oklch(0.8 0.02 290);
	}

	.card__links .card__code:hover {
		color: var(--color-amber);
	}
</style>
