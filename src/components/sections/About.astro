---
import SectionHeading from '../SectionHeading.astro';
import Placeholder from '../Placeholder.astro';
import { about, stats } from '../../data/site';
---

<section id="about" class="section">
	<div class="container split">
		<div class="split__aside">
			<SectionHeading index="02" title="About" />
		</div>

		<div class="about">
			<p class="about__lead">{about.lead}</p>

			<div class="about__grid">
				<div class="about__portrait">
					<Placeholder label="Portrait" ratio="4 / 5" />
				</div>
				<div class="about__text">
					{about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>

			<dl class="about__stats">
				{
					stats.map((stat) => (
						<div class="about__stat">
							<dt class="eyebrow">{stat.label}</dt>
							<dd>{stat.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</section>

<style>
	.about {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
	}

	.about__lead {
		font-size: var(--text-xl);
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.01em;
		max-width: 32ch;
	}

	.about__grid {
		display: grid;
		gap: 2rem;
	}

	.about__text {
		display: grid;
		align-content: start;
		gap: 1.25rem;
		color: var(--color-muted);
	}

	.about__stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.about__stat {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.5rem;
	}

	.about__stat dd {
		font-size: var(--text-2xl);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	@media (min-width: 768px) {
		.about__grid {
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
			gap: 3rem;
		}
	}
</style>
