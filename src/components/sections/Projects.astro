---
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import { projects } from '../../data/site';
---

<section id="work" class="section">
	<div class="container">
		<div class="projects__header">
			<SectionHeading index="01" title="Selected work">
				<p>A few projects I'm proud of. Swap in your own story here.</p>
			</SectionHeading>
			<a class="btn btn--ghost" href="#">All projects →</a>
		</div>

		<ul role="list" class="projects__grid">
			{
				projects.map((project) => (
					<li class={`projects__item projects__item--${project.size ?? 'default'}`}>
						<ProjectCard {...project} />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.projects__header {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.projects__grid {
		display: grid;
		gap: 1rem;
	}

	.projects__item {
		display: grid;
	}

	@media (min-width: 640px) {
		.projects__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-auto-rows: minmax(18rem, auto);
			grid-auto-flow: dense;
		}

		.projects__item--large,
		.projects__item--wide {
			grid-column: span 2;
		}

		.projects__item--large,
		.projects__item--tall {
			grid-row: span 2;
		}
	}

	@media (min-width: 1024px) {
		.projects__grid {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.projects__item--default,
		.projects__item--tall {
			grid-column: span 2;
		}

		.projects__item--wide {
			grid-column: span 3;
		}

		.projects__item--large {
			grid-column: span 4;
		}
	}
</style>
