---
interface Props {
	label: string;
	title: string;
}

const { label, title } = Astro.props;
---

<div class="section-heading">
	<span class="label" data-arrive="label">{label}</span>
	<h2 data-arrive="title">{title}</h2>
</div>

<style>
	.section-heading {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(36px, 4.6vw, 60px);
		letter-spacing: -0.03em;
		line-height: 1.05;
	}
</style>
