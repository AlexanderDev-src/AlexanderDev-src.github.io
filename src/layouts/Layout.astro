---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	// Leave out the header and footer, for full-screen pages like /welcome.
	bare?: boolean;
}

const { title = 'Portfolio', description = 'Personal portfolio', bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#070a12" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Manrope:wght@400;500;600&display=swap"
		/>
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="page" id="top">
			<canvas id="space" class="space" aria-hidden="true"></canvas>
			<div id="dim" class="dim" aria-hidden="true"></div>
			<div class="vignette" aria-hidden="true"></div>

			<div class="page__content">
				{!bare && <Header />}
				<main id="main">
					<slot />
				</main>
				{!bare && <Footer />}
			</div>
		</div>

		<script>
			import { startCosmos } from '../scripts/cosmos';
			import { startJumps } from '../scripts/jump';
			import { startTilt } from '../scripts/tilt';
			startCosmos();
			startJumps();
			startTilt();
		</script>
	</body>
</html>

<style>
	.page {
		position: relative;
		min-height: 100vh;
		overflow-x: clip;
	}

	.space {
		position: fixed;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		background: var(--color-bg);
	}

	/* Darkens the 3D scene behind the text-heavy sections. cosmos.ts sets its opacity. */
	.dim {
		position: fixed;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: oklch(0.06 0.015 250);
		opacity: 0;
	}

	.vignette {
		position: fixed;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: radial-gradient(
			ellipse at 50% 40%,
			transparent 40%,
			oklch(0.06 0.015 250 / 0.75) 100%
		);
	}

	.page__content {
		position: relative;
		z-index: 3;
	}
</style>
