---
import { site, nav } from '../data/site';
---

<header class="header">
	<nav aria-label="Primary" class="container header__inner">
		<a href="#top" class="header__logo">
			<span class="header__mark" aria-hidden="true"></span>
			{site.name.toUpperCase()}
		</a>

		<div class="header__links">
			{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			<span class="header__status">
				<span class="header__dot" aria-hidden="true"></span>
				{site.status.replaceAll(' · ', '\u00a0· ')}
			</span>
		</div>
	</nav>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: oklch(0.08 0.015 285 / 0.5);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--hairline-soft);
	}

	.header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding-block: 18px;
	}

	.header__logo {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 18px;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.header__mark {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: oklch(0.06 0.01 285);
		box-shadow:
			0 0 0 2px var(--color-amber),
			0 0 16px 2px oklch(0.72 0.17 300 / 0.8);
	}

	.header__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(16px, 3vw, 32px);
		font-size: 15px;
	}

	/* The text may wrap on small screens. A 16px radius is half the one-line height,
	   so it still reads as a pill on one line and as a rounded box on two. */
	.header__status {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		min-width: 0;
		padding: 6px 12px;
		border: 1px solid var(--hairline-strong);
		border-radius: 16px;
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1.5;
		color: oklch(0.85 0.02 290);
		text-wrap: balance;
	}

	.header__dot {
		flex-shrink: 0;
		width: 7px;
		height: 7px;
		margin-top: calc((1.5em - 7px) / 2);
		border-radius: 50%;
		background: var(--color-amber);
		box-shadow: 0 0 10px var(--color-amber);
	}
</style>
