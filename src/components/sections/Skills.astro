---
import SectionHeading from '../SectionHeading.astro';
import { skills, darkIcons, deviconUrl } from '../../data/site';
---

<section id="skills" class="container skills">
	<SectionHeading label="02 / SKILLS" title="Tools I use" />

	<div class="skills__grid">
		{
			skills.map((group) => (
				<div class="skills__group">
					<h3 class="skills__title">{group.group}</h3>
					<ul role="list" class="skills__list">
						{group.items.map((item) => (
							<li class="skills__tile" title={item.name}>
								<img
									src={deviconUrl(item.id)}
									alt={item.name}
									width="30"
									height="30"
									loading="lazy"
									class:list={{ 'is-dark': darkIcons.includes(item.id) }}
								/>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.skills {
		display: flex;
		flex-direction: column;
		gap: 44px;
		padding-top: clamp(80px, 12vh, 140px);
	}

	.skills__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: clamp(20px, 2.5vw, 28px);
	}

	.skills__group {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 24px;
		border-radius: 20px;
		border: 1px solid var(--hairline);
		background: oklch(0.12 0.02 285 / 0.55);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.skills__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 20px;
		line-height: 1.3;
		color: oklch(0.92 0.04 60);
	}

	.skills__list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.skills__tile {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 16px;
		border: 1px solid oklch(1 0 0 / 0.1);
		background: oklch(1 0 0 / 0.04);
		transition:
			transform 0.35s var(--ease-out),
			border-color 0.35s,
			box-shadow 0.35s;
	}

	.skills__tile:hover {
		transform: translateY(-4px) scale(1.06);
		border-color: oklch(0.72 0.17 300 / 0.6);
		box-shadow: 0 0 24px oklch(0.6 0.2 300 / 0.4);
	}

	.skills__tile img {
		width: 30px;
		height: 30px;
	}

	.skills__tile img.is-dark {
		filter: invert(1);
	}
</style>
